{
  "Logging": {
    "Json": true,
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Arca": {
    "Ambiente": "Homologacion",
    "CacheTicketPath": "/data/ta",
    "RegistroEmisionesPath": "/data/emisiones",
    "PlantillasPath": "/data/plantillas",
    "AuditoriaPath": "/data/auditoria/auditoria.jsonl",
    "ValidarContraTablasArca": true,
    "ReconciliadorIntervaloSegundos": 60
  },
  "Seguridad": {
    "Clientes": [
      {
        "Nombre": "erp",
        "Claves": [],
        "Permisos": [
          "emitir",
          "consultar"
        ],
        "RateLimitPorMinuto": 300,
        "CuotaDiariaEmisiones": 5000
      },
      {
        "Nombre": "ops",
        "Claves": [],
        "Permisos": [
          "consultar",
          "admin"
        ],
        "IpsPermitidas": [
          "10.0.0.0/8"
        ]
      }
    ]
  },
  "Api": {
    "ForzarHttps": false,
    "RateLimitPorMinuto": 120,
    "EmisionesConcurrentes": 16
  },
  "Swagger": {
    "Habilitado": true
  }
}